{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [".agents/**/*.ts"],
  "exclude": ["node_modules", "server", "app"]
}
