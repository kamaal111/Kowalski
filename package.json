{
  "name": "kowalski",
  "version": "1.0.0",
  "keywords": [],
  "author": "Kamaal Farah",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "server": "pnpm --filter kowalski-server"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@hono/node-server": "^2.1.1",
    "@hono/structured-logger": "^1.0.0",
    "@hono/swagger-ui": "~0.6.1",
    "@kamaalio/hono-standard-openapi": "^0.0.15",
    "@kamaalio/kamaal": "~0.9.11",
    "@kamaalio/kamaal-auth-hono": "~0.0.9",
    "better-auth": "1.7.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "js-yaml": "^5.4.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@kamaal111/oxlint-plugin-anti-slop": "^0.0.3",
    "@oxlint/plugins": "^1.81.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
