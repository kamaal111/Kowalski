{
  "name": "kowalski",
  "version": "1.0.0",
  "keywords": [],
  "author": "Kamaal Farah",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "server": "pnpm --filter kowalski-server"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.1",
    "@hono/node-server": "^2.0.11",
    "@hono/structured-logger": "^1.0.0",
    "@hono/swagger-ui": "~0.6.1",
    "@kamaalio/hono-standard-openapi": "^0.0.15",
    "@kamaalio/kamaal": "~0.9.11",
    "@kamaalio/kamaal-auth-hono": "~0.0.9",
    "better-auth": "1.7.0-rc.1",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.31",
    "jose": "^6.2.4",
    "js-yaml": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "xml2js": "^0.6.2",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
