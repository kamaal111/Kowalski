{
  "name": "kowalski",
  "version": "1.0.0",
  "keywords": [],
  "author": "Kamaal Farah",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "server": "pnpm --filter kowalski-server"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/structured-logger": "catalog:",
    "@hono/swagger-ui": "catalog:",
    "@kamaalio/hono-standard-openapi": "catalog:",
    "@kamaalio/kamaal": "catalog:",
    "@kamaalio/kamaal-auth-hono": "catalog:",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "cheerio": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "js-yaml": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "xml2js": "catalog:",
    "yahoo-finance2": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kamaal111/kamaal-quality-config": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/xml2js": "catalog:",
    "drizzle-kit": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
